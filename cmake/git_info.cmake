# Writes OUTPUT, a header with the engine repo's git commit and dirty flag.
# Runs at every build (see CMakeLists.txt), so a rebuild after a commit or an
# edit embeds the current state; the header only changes when they do.
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P cmake/git_info.cmake
set(sha "unknown")
set(dirty "true")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE head
        RESULT_VARIABLE head_result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(head_result EQUAL 0)
        set(sha "${head}")
        # Tracked changes only: build directories and scratch files are ignored.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE status
            RESULT_VARIABLE status_result
            ERROR_QUIET)
        if(status_result EQUAL 0 AND status STREQUAL "")
            set(dirty "false")
        endif()
    endif()
endif()
file(WRITE "${OUTPUT}.tmp"
    "// Generated by cmake/git_info.cmake at build time.\n"
    "#pragma once\n"
    "#define CPPANATRON_GIT_SHA \"${sha}\"\n"
    "#define CPPANATRON_GIT_DIRTY ${dirty}\n")
# Unchanged contents keep the old timestamp, so nothing recompiles.
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
